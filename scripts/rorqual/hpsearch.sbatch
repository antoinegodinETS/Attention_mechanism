#!/bin/bash
# Phase 5 hyperparameter search on CIFAR-10: the 8 trials of ONE mechanism, 30 epochs each, run
# in order through configs/queue/phase5_hpsearch_<mechanism>.txt (generated by
# scripts/hpsearch.py). Submit one job per mechanism; the three run in parallel. Output in
# $SYS819_RUNS/cifar10-32-p4-<mechanism>-search.t<i>-s<i>/.
#
# GPU size: a 1g.10gb MIG slice (1/7 of an H100's compute, 10 GB), the smallest Rorqual offers.
# A 30-epoch trial at 32 px needs well under 1 GB and search timings are not reported (all time
# and memory numbers in the report come from full H100s), so speed only has to keep each job
# within its time limit. Packing a mechanism's 8 trials into one job on the smallest slice makes
# each job last roughly 1-2 h (the 100-epoch baseline took 8 min on a 3g.40gb slice; on 1/7 of an
# H100 with one loader worker an epoch is several times slower), which respects the Alliance's
# minimum job length of about 1 hour without holding a larger slice idle. 2 CPU cores is a 1/8
# share of an H100's 16 cores per GPU on a Rorqual node (1 loader worker). One MIG slice per job.
#
# Submit from a login node (the account comes from env.sh), one job per mechanism:
#     source ~/SYS819/scripts/rorqual/env.sh
#     for m in full windows axial; do
#         sbatch --job-name=sys819-hps-$m --export=ALL,SYS819_MECH=$m "$SYS819_REPO/scripts/rorqual/hpsearch.sbatch"
#     done
# Resumable: Slurm sends USR1 5 minutes before the time limit; the current trial checkpoints, the
# queue exits with status 3 and this script resubmits itself with the same SYS819_MECH (up to
# SYS819_MAX_CHUNKS jobs). Finished trials are skipped and a partial one resumes from last.pt, so
# resubmitting by hand after any failure is also safe.
#SBATCH --job-name=sys819-hps
#SBATCH --gpus=nvidia_h100_80gb_hbm3_1g.10gb:1
#SBATCH --cpus-per-task=2
#SBATCH --mem=16G
#SBATCH --time=03:00:00
#SBATCH --signal=B:USR1@300
#SBATCH --output=%x-%j.out
set -euo pipefail

case "${SYS819_MECH:-}" in
    full | windows | axial) ;;
    *)
        echo "error: set SYS819_MECH to full, windows or axial (sbatch --export=ALL,SYS819_MECH=full ...)" >&2
        exit 2
        ;;
esac

# shellcheck disable=SC1091
source "${SYS819_REPO:-$SLURM_SUBMIT_DIR}/scripts/rorqual/env.sh"
sys819_activate
sys819_stage_data cifar10

cd "$SYS819_REPO"
queue="configs/queue/phase5_hpsearch_${SYS819_MECH}.txt"
nvidia-smi
echo "mechanism: $SYS819_MECH, queue: $queue, runs root: $SYS819_RUNS"
status=0
sys819_run_queue "$queue" "$SYS819_REPO/scripts/rorqual/hpsearch.sbatch" \
    --set "data.num_workers=$((SLURM_CPUS_PER_TASK - 1))" || status=$?
python scripts/status.py "$queue"
exit "$status"
